{
  "name": "pickupnewdate",
  "version": "1.1.1",
  "description": "Simple multilingual calendar library for browsers and Node.js.",
  "type": "module",
  "main": "./dist/pickupnewdate.cjs",
  "module": "./dist/pickupnewdate.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pickupnewdate.esm.js",
      "require": "./dist/pickupnewdate.cjs",
      "default": "./dist/pickupnewdate.esm.js"
    },
    "./style.css": "./dist/pickupnewdate.css"
  },
  "files": [
    "dist/",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && rollup -c && npm run build:types && npm run build:assets",
    "build:types": "tsc -p tsconfig.build.json",
    "build:assets": "node -e \"import('node:fs').then(({copyFileSync}) => copyFileSync('style.css', 'dist/pickupnewdate.css'))\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test calendar.test.ts",
    "test:build": "npm run build && npm run typecheck && npm test",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peniakoff/pick-up-new-date.git"
  },
  "keywords": [
    "calendar",
    "datepicker",
    "i18n"
  ],
  "author": "Tomasz Miller",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/peniakoff/pick-up-new-date/issues"
  },
  "homepage": "https://github.com/peniakoff/pick-up-new-date#readme",
  "style": "./dist/pickupnewdate.css",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "unpkg": "dist/pickupnewdate.umd.js",
  "jsdelivr": "dist/pickupnewdate.umd.js",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.60.4",
    "tslib": "^2.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
